VITE_API_BASE_URL=https://pgcollege.ui.edu.ng/registrationbackend/public/api
# Shared login defaults: localhost:5175/login in dev, applicationfrontend/login in production.
# VITE_APPLICATION_LOGIN_URL=https://app.pgcollege.ui.edu.ng/applicationfrontend/login
# Set false only to test the standalone registration login.
VITE_USE_SHARED_LOGIN=false
# Defaults to / on Vercel and in dev, and /newregistrationportal/ on other production hosts.
# This explicit value overrides the deployment-aware default.
# VITE_PUBLIC_BASE_PATH=/newregistrationportal/
# Demo login is enabled by default during npm run dev; production builds disable it.
# Set true explicitly to allow demo login in a preview build, or false to disable it locally.
# VITE_ENABLE_DEMO_LOGIN=false
